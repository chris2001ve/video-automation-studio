{
  "name": "video-automation-studio",
  "productName": "Video Automation Studio",
  "version": "1.1.0",
  "description": "Generación de videos con IA por lotes (Seedance y otros) usando APIs oficiales",
  "main": "dist-electron/main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:renderer && npm run build:main",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "build": {
    "appId": "com.tuisladigital.videoautomationstudio",
    "productName": "Video Automation Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "artifactName": "Video-Automation-Studio-Setup-${version}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Video Automation Studio",
      "installerLanguages": [
        "es_ES",
        "en_US"
      ],
      "language": "3082"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "maintainer": "chris2001ve <chris2001ve@users.noreply.github.com>",
      "synopsis": "Generación de videos con IA por lotes",
      "description": "Genera videos con IA (Seedance y otros) por lotes usando APIs oficiales.",
      "desktop": {
        "entry": {
          "Name": "Video Automation Studio",
          "Comment": "Generación de videos con IA por lotes",
          "Categories": "AudioVideo;Video;"
        }
      },
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0 | libatspi2.0-0t64",
        "libuuid1",
        "libasound2 | libasound2t64"
      ],
      "artifactName": "video-automation-studio_${version}_amd64.${ext}",
      "recommends": [
        "libnotify4",
        "libsecret-1-0",
        "libappindicator3-1"
      ]
    },
    "appImage": {
      "artifactName": "Video-Automation-Studio-${version}.${ext}"
    }
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "undici": "^6.29.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.62.0",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "author": {
    "name": "chris2001ve",
    "email": "chris2001ve@users.noreply.github.com"
  },
  "homepage": "https://github.com/chris2001ve/video-automation-studio",
  "desktopName": "video-automation-studio.desktop"
}
